# ZORX — environment variables (copy to .env.local; never commit real values)

# Verified production origin, used at BUILD time for canonical URLs, the sitemap,
# robots.txt and structured data. https only; no trailing path. Leave unset on
# previews: without it the site is noindex.
SITE_URL=

# Set to "true" on staging builds that use the real domain but must not be indexed.
SITE_NOINDEX=

# Google Search Console — HTML tag verification token (content="…" value only).
GOOGLE_SITE_VERIFICATION=
